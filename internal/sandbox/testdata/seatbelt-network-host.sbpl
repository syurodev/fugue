(version 1)
(deny default)
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/lib")
  (subpath "/System/Library")
  (subpath "/Library/Frameworks")
  (subpath "/private/var/db/dyld")
  (subpath "/etc")
  (subpath "/private/etc")
  (literal "/")
)
(allow file-read* file-write* (require-all (literal "/dev/null") (vnode-type CHARACTER-DEVICE)))
(allow file-read* file-write*
  (subpath "/Users/alice/workspace/app")
  (subpath "/Users/alice")
)
(allow mach-lookup (global-name "com.apple.SecurityServer"))
(allow file-read*
  (subpath "/Users/alice/Library/Keychains")
)
(allow file-read-metadata (literal "/Users"))
(allow file-read-data (literal "/Users"))
(allow file-read-metadata (literal "/Users/alice"))
(allow file-read-data (literal "/Users/alice"))
(allow file-read-metadata (literal "/Users/alice/workspace"))
(allow file-read-data (literal "/Users/alice/workspace"))
(allow file-read-metadata (literal "/private"))
(allow file-read-metadata (literal "/private/tmp"))
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write* file-ioctl (require-all (regex #"^/dev/ttys[0-9]+$") (extension "com.apple.sandbox.pty")))
(allow sysctl-read)
(allow mach-lookup (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent") (local-name "com.apple.cfprefsd.agent"))
(allow ipc-posix-shm-read* (ipc-posix-name-prefix "apple.cfprefs."))
(allow user-preference-read
  (preference-domain "com.openai.codex")
)
(allow network-outbound (remote ip "*:*"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
(allow file-read-metadata (literal "/private/var") (literal "/private/var/run") (literal "/var") (literal "/var/run"))
(allow file-read* (literal "/private/var/run/resolv.conf") (literal "/var/run/resolv.conf"))
(allow file-read* (subpath "/private/var/db/timezone") (subpath "/var/db/timezone"))
(allow mach-lookup (global-name "com.apple.SystemConfiguration.configd"))
(allow mach-lookup (global-name "com.apple.mDNSResponder"))
(allow mach-lookup (global-name "com.apple.dns.service"))
(allow mach-lookup (global-name "com.apple.dns.registration"))
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow mach-lookup (global-name "com.apple.system.notification_center"))
(allow mach-lookup (global-name "com.apple.SecurityServer"))
(allow mach-lookup (global-name "com.apple.trustd.agent"))
(deny file-read* (subpath "/var/root"))
(deny file-read* (subpath "/private/var/root"))
(deny file-read* (subpath "/var/db/Keychains"))
(deny file-read* (subpath "/private/var/db/Keychains"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-bind (local ip "localhost:1455"))
(allow network-inbound (local ip "localhost:1455"))
(deny file-read* file-write* (regex #"^/private/tmp/dk-"))
(allow file-read* file-write* (subpath "/private/tmp/dk-12345678"))
(allow network-bind network-inbound (local unix-socket (subpath "/private/tmp/dk-12345678")))
(allow network-outbound (remote unix-socket (subpath "/private/tmp/dk-12345678")))
(deny file-read* file-write*
  (subpath "/Users/alice/.ssh")
  (subpath "/Users/alice/.gnupg")
  (subpath "/Users/alice/.aws")
  (subpath "/Users/alice/.config/gcloud")
)
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice/.config")))

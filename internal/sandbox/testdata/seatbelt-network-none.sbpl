(version 1)
(deny default)
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/lib")
  (subpath "/System/Library")
  (subpath "/Library/Frameworks")
  (subpath "/private/var/db/dyld")
  (subpath "/etc")
  (subpath "/private/etc")
  (literal "/")
)
(allow file-read* file-write* (require-all (literal "/dev/null") (vnode-type CHARACTER-DEVICE)))
(allow file-read* file-write*
  (subpath "/Users/alice/workspace/app")
  (subpath "/Users/alice/workspace/shared")
  (subpath "/tmp")
  (subpath "/private/tmp")
)
(allow file-read*
  (subpath "/opt/tools")
)
(allow file-read-metadata (literal "/Users"))
(allow file-read-metadata (literal "/Users/alice"))
(allow file-read-metadata (literal "/Users/alice/workspace"))
(allow file-read-metadata (literal "/opt"))
(allow file-read-metadata (literal "/private"))
(allow file-read-metadata (literal "/private/tmp"))
(allow file-read-metadata (literal "/private"))
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write* file-ioctl (require-all (regex #"^/dev/ttys[0-9]+$") (extension "com.apple.sandbox.pty")))
(allow sysctl-read)
(deny network-outbound)
(deny network-inbound)
(allow network-outbound (literal "/private/tmp/mcp.sock"))
(deny file-read* file-write* (regex #"^/private/tmp/dk-"))
(deny file-write*
  (subpath "/Users/alice/workspace/app/AGENTS.md")
)
(deny file-read* file-write*
  (subpath "/Users/alice/.ssh")
  (subpath "/Users/alice/.gnupg")
  (subpath "/Users/alice/.aws")
  (subpath "/Users/alice/.config/gcloud")
  (subpath "/Users/alice/workspace/app/.env")
  (subpath "/Users/alice/Library/Keychains")
)
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice/.config")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice/Library")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice/workspace")))
(deny file-write-unlink (require-all (vnode-type DIRECTORY) (literal "/Users/alice/workspace/app")))
